{
  "name": "BGA Workshop - EASEL and EnTAP",
  "image": "ghcr.io/thebgacademy/easel_entap_2024:sha-56832f73f58fe455841c272171535f16318fc848",
  "features": {
    // We need docker in docker due to how the pipeline runs containers
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {},
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },
  "privileged": true,
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "desktop",
			"onAutoForward": "silent",
      "visibility": "public"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh"
}
